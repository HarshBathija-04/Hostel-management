{
  "name": "hostel-api",
  "version": "1.0.0",
  "description": "Hostel Room Allotment System - JSON API (Express + PostgreSQL)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "start:prod": "node db/migrate.js && node db/seed.js && node server.js",
    "migrate": "node db/migrate.js",
    "seed": "node db/seed.js",
    "lint": "eslint .",
    "test": "jest --runInBand"
  },
  "keywords": [
    "hostel",
    "room-allotment",
    "express",
    "postgresql"
  ],
  "author": "Harsh Bathija",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.1",
    "express-rate-limit": "7.5.1",
    "express-validator": "7.3.1",
    "helmet": "7.2.0",
    "jsonwebtoken": "9.0.3",
    "morgan": "1.10.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "supertest": "7.3.2"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "./tests/globalSetup.js",
    "setupFiles": [
      "./tests/env.js"
    ]
  }
}
