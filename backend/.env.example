# Hostel API - copy to backend/.env for local development.

NODE_ENV=development
PORT=5124

# Postgres connection. The app keeps all its tables in the DB_SCHEMA schema.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/portfolio
DB_SCHEMA=hostel_management
# Set to true only when connecting over Render's *external* URL (TLS required there).
DATABASE_SSL=false

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE=24h
BCRYPT_ROUNDS=10

# Comma-separated list of allowed browser origins (CORS).
FRONTEND_URL=http://localhost:5212

# General API rate limit per IP per 15 minutes (auth routes are capped at 20).
RATE_LIMIT_MAX_REQUESTS=300
